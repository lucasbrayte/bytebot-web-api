DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
FRONTEND_REDIRECT_URL=http://localhost:3002
BOT_TOKEN=

# Optional: enable internal ByteBot HTTP bridge
# BYTEBOT_API_URL=http://localhost:3001
# BYTEBOT_API_KEY=

# Required: random stable secret of at least 32 bytes, shared by all instances.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# SESSION_SECRET is accepted as a fallback if COOKIE_SECRET is absent.
# Vercel: DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/callback
# Vercel: FRONTEND_REDIRECT_URL=/
# Vercel: BYTEBOT_API_URL must be the bot's reachable HTTPS bridge, not localhost.
